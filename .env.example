# ==========================================
# MarketMind AI - Secure Environment Configuration
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls and server-side synthesis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Server-only multi-provider AI orchestration. Never expose these as VITE_* variables.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
PERPLEXITY_API_KEY=""
AI_ENABLED_PROVIDERS="gemini"
OPENAI_MODEL=""
ANTHROPIC_MODEL=""
PERPLEXITY_MODEL=""
AI_DAILY_REQUEST_LIMIT="1000"
AI_MAX_PROVIDER_ATTEMPTS="2"
AI_CACHE_ENABLED="true"
AI_MAX_OUTPUT_TOKENS="1200"
AI_REQUEST_TIMEOUT_MS="15000"
AI_RETRIES_PER_PROVIDER="2"
AI_CIRCUIT_FAILURE_THRESHOLD="3"
AI_CIRCUIT_RESET_MS="60000"
AI_OPENAI_DAILY_COST_USD="25"
AI_GEMINI_DAILY_COST_USD="25"
AI_ANTHROPIC_DAILY_COST_USD="25"
AI_PERPLEXITY_DAILY_COST_USD="25"

# Licensed/partner publisher boundaries. Leave blank until contractual feed rights are confirmed.
REUTERS_NEWS_ENDPOINT=""
REUTERS_NEWS_TOKEN=""
AP_NEWS_ENDPOINT=""
AP_NEWS_TOKEN=""
BARRONS_NEWS_ENDPOINT=""
BARRONS_NEWS_TOKEN=""
FIDELITY_NEWS_ENDPOINT=""
FIDELITY_NEWS_TOKEN=""
SCHWAB_NEWS_ENDPOINT=""
SCHWAB_NEWS_TOKEN=""
ETRADE_NEWS_ENDPOINT=""
ETRADE_NEWS_TOKEN=""
INVESTING_NEWS_ENDPOINT=""
INVESTING_NEWS_TOKEN=""
ECONOMIC_TIMES_FEED_ENDPOINT=""

# FINNHUB_API_KEY: Official API key for Finnhub company news, earnings transcripts, and market feeds.
FINNHUB_API_KEY=""

# BENZINGA_API_KEY: Official API key for Benzinga Pro breaking market news, earnings, and analyst updates.
BENZINGA_API_KEY=""

# MASSIVE_API_KEY / POLYGON_API_KEY: API key for Massive / Polygon institutional market data & real-time news.
MASSIVE_API_KEY=""
POLYGON_API_KEY=""

# ALPACA_API_KEY & ALPACA_API_SECRET: Official credentials for Alpaca real-time market data & 5,000+ universe sync.
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
ALPACA_DATA_FEED="iex"
MAX_ACTIVE_STREAM_SYMBOLS="30"
INSTRUMENT_SYNC_PROVIDER="alpaca"
ALPACA_RATE_LIMIT_PER_MINUTE="200"

# CNBC API & OFFICIAL RSS FEED: CNBC RSS operates unauthenticated without an API key using CNBC_FEED_URL. CNBC_API_KEY is optional.
CNBC_API_KEY=""
CNBC_FEED_URL="https://search.cnbc.com/rs/search/view.html?partnerId=2000&keywords=markets&sort=date"

# YAHOO FINANCE API & FEED: YAHOO_FINANCE_API_KEY is optional. Ingestion uses official RSS (YAHOO_FINANCE_FEED_URL). No scraping or unofficial endpoints.
YAHOO_FINANCE_API_KEY=""
YAHOO_FINANCE_FEED_URL="https://finance.yahoo.com/news/rssindex"

# BLOOMBERG API & FEED: Enterprise licensed API or terminal feed URL for Bloomberg News.
BLOOMBERG_API_KEY=""
BLOOMBERG_FEED_URL=""

# FOX NEWS & FOX BUSINESS FEEDS: Approved feed URLs for Fox Business and Fox News.
FOX_NEWS_FEED_URL="https://moxie.foxnews.com/google-publisher/latest.xml"
FOX_BUSINESS_FEED_URL="https://moxie.foxbusiness.com/google-publisher/latest.xml"

# CNN & CNN BUSINESS FEEDS: Approved feed URLs for CNN and CNN Business.
CNN_FEED_URL="http://rss.cnn.com/rss/cnn_topstories.rss"
CNN_BUSINESS_FEED_URL="http://rss.cnn.com/rss/money_latest.rss"

# SEC_USER_AGENT: User-Agent header for official SEC EDGAR RSS/API queries.
SEC_USER_AGENT="MarketMindAI Research/2.0 (contact@marketmind.ai)"

# Stripe Production Billing Configuration - 8 Canonical Price IDs
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASIC_MONTHLY=""
STRIPE_PRICE_BASIC_ANNUAL=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_ANNUAL=""
STRIPE_PRICE_ULTRA_MONTHLY=""
STRIPE_PRICE_ULTRA_ANNUAL=""

# Market Simulation Control (true in development, false in production)
ALLOW_SIMULATED_MARKET_DATA="false"
MARKET_DATA_MODE="end_of_day"
VITE_MARKET_DATA_MODE="end_of_day"

# Firebase Admin Service Account Key (JSON string or path) and Project ID
FIREBASE_PROJECT_ID="gen-lang-client-0282286222"
FIREBASE_DATABASE_ID="ai-studio-marketmindai-52b43fbe-5366-4a57-8a3b-5ac098b91d46"
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Supabase application persistence. The publishable key is browser-safe; the secret key is server-only.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="https://your-render-service.onrender.com"

# Render supplies PORT automatically. Keep these values for local development.
PORT="3000"
NODE_ENV="development"
