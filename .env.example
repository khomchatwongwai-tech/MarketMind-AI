# ==========================================
# MarketMind AI - Secure Environment Configuration
# ==========================================

# Node Environment
NODE_ENV="production"

# APP_URL: Canonical URL where the web application is hosted.
APP_URL="https://marketmind.ai"

# ==========================================
# Supabase Production Configuration (Database & Auth)
# ==========================================
# VITE_SUPABASE_URL: Browser-accessible Supabase project URL (must use HTTPS).
VITE_SUPABASE_URL=""

# VITE_SUPABASE_PUBLISHABLE_KEY / VITE_SUPABASE_ANON_KEY: Client-safe publishable key.
VITE_SUPABASE_PUBLISHABLE_KEY=""

# SUPABASE_URL: Server-side Supabase project URL (must match VITE_SUPABASE_URL).
SUPABASE_URL=""

# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY: Server-only Supabase service key.
SUPABASE_SECRET_KEY=""

# ==========================================
# Google Gemini AI & Model Configuration
# ==========================================
# GEMINI_API_KEY: Required for Gemini AI API calls and server-side quantitative intelligence.
GEMINI_API_KEY=""

# GEMINI_MODEL: Default Gemini model identifier (e.g. gemini-2.5-flash or gemini-2.5-pro)
GEMINI_MODEL="gemini-2.5-flash"

# ==========================================
# Firebase Admin & Firestore Configuration
# ==========================================
FIREBASE_PROJECT_ID="ai-studio-marketmindai-52b43fbe-5366-4a57-8a3b-5ac098b91d46"
FIREBASE_DATABASE_ID=""
FIREBASE_SERVICE_ACCOUNT_KEY=""

# ==========================================
# Stripe Production Billing Configuration
# ==========================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Monthly Stripe Price IDs
STRIPE_PRICE_BASIC_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_ULTRA_MONTHLY=""

# Annual Stripe Price IDs
STRIPE_PRICE_BASIC_ANNUAL=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_PREMIUM_ANNUAL=""
STRIPE_PRICE_ULTRA_ANNUAL=""

# ==========================================
# Market Data Feeds & Zero Fabrication Safeguards
# ==========================================
# Market Simulation Control: Strictly "false" in production (fails closed).
ALLOW_SIMULATED_MARKET_DATA="false"

# Market Data Mode: "provider" for live institutional feeds.
MARKET_DATA_MODE="provider"
DEMO_MODE="false"

# MASSIVE_API_KEY / POLYGON_API_KEY: API key for Massive / Polygon institutional market data & WebSocket feeds.
MASSIVE_API_KEY=""
POLYGON_API_KEY=""

# ALPACA_API_KEY & ALPACA_API_SECRET: Official credentials for Alpaca real-time market and news streams.
ALPACA_API_KEY=""
ALPACA_API_SECRET=""

# FINNHUB_API_KEY: Official API key for Finnhub company news, earnings transcripts, and market feeds.
FINNHUB_API_KEY=""

# BENZINGA_API_KEY: Official API key for Benzinga Pro breaking market news and analyst updates.
BENZINGA_API_KEY=""

# CNBC API & OFFICIAL RSS FEED
CNBC_API_KEY=""
CNBC_FEED_URL="https://search.cnbc.com/rs/search/view.html?partnerId=2000&keywords=markets&sort=date"

# YAHOO FINANCE API & FEED
YAHOO_FINANCE_API_KEY=""
YAHOO_FINANCE_FEED_URL="https://finance.yahoo.com/news/rssindex"

# BLOOMBERG API & FEED
BLOOMBERG_API_KEY=""
BLOOMBERG_FEED_URL=""

# FOX NEWS & FOX BUSINESS FEEDS
FOX_NEWS_FEED_URL="https://moxie.foxnews.com/google-publisher/latest.xml"
FOX_BUSINESS_FEED_URL="https://moxie.foxbusiness.com/google-publisher/latest.xml"

# CNN & CNN BUSINESS FEEDS
CNN_FEED_URL="http://rss.cnn.com/rss/cnn_topstories.rss"
CNN_BUSINESS_FEED_URL="http://rss.cnn.com/rss/money_latest.rss"

# SEC_USER_AGENT: User-Agent header for official SEC EDGAR queries (Format: Sample Company contact@example.com).
SEC_USER_AGENT="MarketMindAI Research/2.0 (contact@marketmind.ai)"
