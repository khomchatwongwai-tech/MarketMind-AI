rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation: UserProfile
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             data.role in ['user', 'premium_user', 'support', 'moderator', 'admin', 'super_admin'] &&
             data.plan in ['free', 'basic', 'pro', 'premium', 'institutional', 'enterprise'];
    }

    // Entity Validation: Watchlist
    function isValidWatchlist(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.tickers is list && data.tickers.size() <= 500;
    }

    // Entity Validation: SavedAlert
    function isValidAlert(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.ticker is string && data.ticker.size() <= 20 &&
             data.type is string && data.type.size() <= 50 &&
             data.status in ['active', 'paused', 'triggered'];
    }

    // Entity Validation: HistoricalPrediction
    function isValidPrediction(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.ticker is string && data.ticker.size() <= 20 &&
             data.direction in ['BULLISH', 'BEARISH', 'NEUTRAL'] &&
             data.status in ['WIN', 'LOSS', 'IN_PROGRESS', 'EXPIRED'];
    }

    // Entity Validation: SupportTicket
    function isValidSupportTicket(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.userEmail is string && data.userEmail.size() <= 150 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.status in ['Open', 'In Review', 'Resolved', 'Closed'];
    }

    // Entity Validation: CommunityPost
    function isValidCommunityPost(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.authorId is string && data.authorId == request.auth.uid &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 5000 &&
             data.status in ['PUBLISHED', 'HIDDEN', 'REMOVED'];
    }

    // Entity Validation: CommunityReport
    function isValidCommunityReport(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.reporterId is string && data.reporterId == request.auth.uid &&
             data.targetType in ['POST', 'COMMENT', 'PROFILE'] &&
             data.targetId is string && data.targetId.size() <= 128 &&
             data.category is string && data.category.size() <= 100 &&
             data.status in ['PENDING', 'ACTION_TAKEN', 'DISMISSED'];
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() || (
          incoming().role == 'user' &&
          incoming().plan == 'free' &&
          (incoming().subscriptionStatus == 'free' || !('subscriptionStatus' in incoming()))
        )
      );

      allow update: if (isOwner(userId) || isAdmin()) && isValidUserProfile(incoming()) && (
        isAdmin() || (
          // Prevent self-elevation of role, plan, billing, or trial status by normal users
          incoming().id == existing().id &&
          incoming().role == existing().role &&
          incoming().plan == existing().plan &&
          (!('planTier' in incoming()) || incoming().planTier == existing().planTier) &&
          (!('subscriptionStatus' in incoming()) || incoming().subscriptionStatus == existing().subscriptionStatus) &&
          (!('hasUsedTrial' in incoming()) || incoming().hasUsedTrial == existing().hasUsedTrial) &&
          (!('paymentCustomerId' in incoming()) || incoming().paymentCustomerId == existing().paymentCustomerId) &&
          (!('paymentSubscriptionId' in incoming()) || incoming().paymentSubscriptionId == existing().paymentSubscriptionId) &&
          (!('monthlyPrice' in incoming()) || incoming().monthlyPrice == existing().monthlyPrice)
        )
      );

      allow delete: if isOwner(userId) || isAdmin();

      // --- USER WATCHLISTS SUBCOLLECTION ---
      match /watchlists/{watchlistId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId) && isValidId(watchlistId) && isValidWatchlist(incoming());
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(watchlistId) && isValidWatchlist(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // --- USER ALERTS SUBCOLLECTION ---
      match /alerts/{alertId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId) && isValidId(alertId) && isValidAlert(incoming());
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(alertId) && isValidAlert(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // --- USER PREDICTIONS SUBCOLLECTION ---
      match /predictions/{predictionId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId) && isValidId(predictionId) && isValidPrediction(incoming());
        allow update: if (isOwner(userId) || isAdmin()) && isValidId(predictionId) && isValidPrediction(incoming()) && (
          isAdmin() || (
            // Immutable prediction fields: user cannot modify original model prediction or finalize status
            incoming().userId == existing().userId &&
            incoming().ticker == existing().ticker &&
            incoming().direction == existing().direction &&
            (!('entryPrice' in existing()) || incoming().entryPrice == existing().entryPrice) &&
            (!('timeframe' in existing()) || incoming().timeframe == existing().timeframe) &&
            (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
            incoming().status == existing().status
          )
        );
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // --- SUPPORT TICKETS COLLECTION ---
    match /supportTickets/{ticketId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && isValidId(ticketId) && isValidSupportTicket(incoming()) && incoming().status == 'Open';
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid &&
          isValidSupportTicket(incoming()) &&
          incoming().userId == existing().userId
        )
      );
      allow delete: if isAdmin();
    }

    // --- COMMUNITY POSTS COLLECTION ---
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(postId) && isValidCommunityPost(incoming()) && incoming().status == 'PUBLISHED';
      allow update: if isSignedIn() && isValidCommunityPost(incoming()) && (
        isAdmin() || (
          resource.data.authorId == request.auth.uid &&
          incoming().authorId == existing().authorId
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    // --- COMMUNITY REPORTS COLLECTION ---
    match /community_reports/{reportId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() && isValidId(reportId) && isValidCommunityReport(incoming()) && incoming().status == 'PENDING';
      allow update, delete: if isAdmin();
    }

    // --- ADMINS COLLECTION ---
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list, write: if isAdmin();
    }

    // System Health Status Document
    match /system_health/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
