# ==========================================
# MarketMind AI - Secure Environment Configuration
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls and server-side synthesis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FINNHUB_API_KEY: Official API key for Finnhub company news, earnings transcripts, and market feeds.
FINNHUB_API_KEY=""

# BENZINGA_API_KEY: Official API key for Benzinga Pro breaking market news, earnings, and analyst updates.
BENZINGA_API_KEY=""

# MASSIVE_API_KEY / POLYGON_API_KEY: API key for Massive / Polygon institutional market data & real-time news.
MASSIVE_API_KEY=""
POLYGON_API_KEY=""

# ALPACA_API_KEY & ALPACA_API_SECRET: Official credentials for Alpaca real-time financial news stream.
ALPACA_API_KEY=""
ALPACA_API_SECRET=""

# CNBC API & OFFICIAL RSS FEED: CNBC RSS operates unauthenticated without an API key using CNBC_FEED_URL. CNBC_API_KEY is optional.
CNBC_API_KEY=""
CNBC_FEED_URL="https://search.cnbc.com/rs/search/view.html?partnerId=2000&keywords=markets&sort=date"

# YAHOO FINANCE API & FEED: YAHOO_FINANCE_API_KEY is optional. Ingestion uses official RSS (YAHOO_FINANCE_FEED_URL). No scraping or unofficial endpoints.
YAHOO_FINANCE_API_KEY=""
YAHOO_FINANCE_FEED_URL="https://finance.yahoo.com/news/rssindex"

# BLOOMBERG API & FEED: Enterprise licensed API or terminal feed URL for Bloomberg News.
BLOOMBERG_API_KEY=""
BLOOMBERG_FEED_URL=""

# FOX NEWS & FOX BUSINESS FEEDS: Approved feed URLs for Fox Business and Fox News.
FOX_NEWS_FEED_URL="https://moxie.foxnews.com/google-publisher/latest.xml"
FOX_BUSINESS_FEED_URL="https://moxie.foxbusiness.com/google-publisher/latest.xml"

# CNN & CNN BUSINESS FEEDS: Approved feed URLs for CNN and CNN Business.
CNN_FEED_URL="http://rss.cnn.com/rss/cnn_topstories.rss"
CNN_BUSINESS_FEED_URL="http://rss.cnn.com/rss/money_latest.rss"

# SEC_USER_AGENT: User-Agent header for official SEC EDGAR RSS/API queries (Format: Sample Company AdminContact@<sample company domain>.com).
SEC_USER_AGENT="MarketMindAI Research/2.0 (contact@marketmind.ai)"

# Stripe Production Billing Configuration
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASIC=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PREMIUM=""

# Market Simulation Control (true in development, false in production)
ALLOW_SIMULATED_MARKET_DATA="false"
MARKET_DATA_MODE="end_of_day"
VITE_MARKET_DATA_MODE="end_of_day"

# Firebase Admin Service Account Key (JSON string or path) and Project ID
FIREBASE_PROJECT_ID="gen-lang-client-0282286222"
FIREBASE_DATABASE_ID="ai-studio-marketmindai-52b43fbe-5366-4a57-8a3b-5ac098b91d46"
FIREBASE_SERVICE_ACCOUNT_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
